# ─── Backend API ─────────────────────────────────────────────────────────────
# Both of these point at the same backend and BOTH INCLUDE the trailing /api.
# (Historically some files appended /api themselves, which double-prefixed the
# path; they now all assume the value already ends in /api.)
NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001/api
# Server-side only: lets server components reach the backend directly.
BACKEND_INTERNAL_URL=http://localhost:5001/api

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (NEW project — same one the backend points at) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── Contact / ops ───────────────────────────────────────────────────────────
NEXT_PUBLIC_OPERATIONS_PHONE=
NEXT_PUBLIC_OPERATIONS_WHATSAPP=
NEXT_PUBLIC_FREE_ASSESSMENT_PSYCHOLOGIST_EMAIL=assessment.koott@gmail.com

# ─── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_BACKEND_DOMAIN=
# Koott first-party analytics (src/analytics). production · staging · development.
# Anything but production shows the demo marketing login hint on /marketing/login.
NEXT_PUBLIC_ANALYTICS_ENV=development
# GA4 web stream (loaded only after analytics consent, with redacted URLs).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-K7Z8F94Z80
# Meta Pixel (src/analytics/meta.js) — OFF until ENABLED is "true"; loads only with
# advertising consent and never on condition or blog pages.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ENABLED=false

# ─── Transactional email from Next route handlers (optional) ─────────────────
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_EMAIL=
